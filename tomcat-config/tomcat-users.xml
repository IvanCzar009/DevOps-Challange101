<?xml version="1.0" encoding="UTF-8"?>
<tomcat-users xmlns="http://tomcat.apache.org/xml"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://tomcat.apache.org/xml tomcat-users.xsd"
              version="1.0">

  <!-- Define roles for Tomcat Manager and Host Manager -->
  <role rolename="tomcat"/>
  <role rolename="manager-gui"/>
  <role rolename="manager-script"/>
  <role rolename="manager-jmx"/>
  <role rolename="manager-status"/>
  <role rolename="admin-gui"/>
  <role rolename="admin-script"/>

  <!-- Define users with roles -->
  <!-- Default admin user (change password in production!) -->
  <user username="admin" 
        password="admin123" 
        roles="tomcat,manager-gui,manager-script,manager-jmx,manager-status,admin-gui,admin-script"/>
  
  <!-- Manager user for CI/CD deployments -->
  <user username="deployer" 
        password="deploy123" 
        roles="manager-script,manager-jmx"/>
  
  <!-- Read-only monitoring user -->
  <user username="monitor" 
        password="monitor123" 
        roles="manager-status"/>

  <!-- Example application user -->
  <user username="tomcat" 
        password="tomcat123" 
        roles="tomcat"/>

</tomcat-users>